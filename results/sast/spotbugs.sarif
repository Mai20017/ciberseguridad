e)"}]}]},{"ruleId":"SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING","ruleIndex":26,"message":{"id":"default","text":"A prepared statement is generated from a nonconstant String","arguments":["org.owasp.benchmark.testcode.BenchmarkTest02730.doPost(HttpServletRequest, HttpServletResponse)"]},"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest02730.java"},"region":{"startLine":55}},"logicalLocations":[{"name":"doPost(HttpServletRequest, HttpServletResponse)","kind":"function","fullyQualifiedName":"org.owasp.benchmark.testcode.BenchmarkTest02730.doPost(HttpServletRequest, HttpServletResponse)"}]}]},{"ruleId":"SQL_INJECTION_SPRING_JDBC","ruleIndex":27,"message":{"id":"default","text":"Potential JDBC Injection (Spring JDBC)","arguments":["org/springframework/jdbc/core/JdbcTemplate.queryForMap(Ljava/lang/String;)Ljava/util/Map;"]},"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest02736.java"},"region":{"startLine":53}},"logicalLocations":[{"name":"doPost(HttpServletRequest, HttpServletResponse)","kind":"function","fullyQualifiedName":"org.owasp.benchmark.testcode.BenchmarkTest02736.doPost(HttpServletRequest, HttpServletResponse)"}]}]},{"ruleId":"SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE","ruleIndex":23,"message":{"id":"default","text":"Nonconstant string passed to execute or addBatch method on an SQL statement","arguments":["org.owasp.benchmark.testcode.BenchmarkTest02738.doPost(HttpServletRequest, HttpServletResponse)"]},"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest02738.java"},"region":{"startLine":54}},"logicalLocations":[{"name":"doPost(HttpServletRequest, HttpServletResponse)","kind":"function","fullyQualifiedName":"org.owasp.benchmark.testcode.BenchmarkTest02738.doPost(HttpServletRequest, HttpServletResponse)"}]}]},{"ruleId":"SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE","ruleIndex":23,"message":{"id":"default","text":"Nonconstant string passed to execute or addBatch method on an SQL statement","arguments":["org.owasp.benchmark.testcode.BenchmarkTest02739.doPost(HttpServletRequest, HttpServletResponse)"]},"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest02739.java"},"region":{"startLine":54}},"logicalLocations":[{"name":"doPost(HttpServletRequest, HttpServletResponse)","kind":"function","fullyQualifiedName":"org.owasp.benchmark.testcode.BenchmarkTest02739.doPost(HttpServletRequest, HttpServletResponse)"}]}]},{"ruleId":"SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE","ruleIndex":23,"message":{"id":"default","text":"Nonconstant string passed to execute or addBatch method on an SQL statement","arguments":["org.owasp.benchmark.testcode.BenchmarkTest02740.doPost(HttpServletRequest, HttpServletResponse)"]},"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"src/main/java/org/owasp/benchmark/testcode/BenchmarkTest02740.java"},"region":{"startLine":54}},"logicalLocations":[{"name":"doPost(HttpServletRequest, HttpServletResponse)","kind":"function","fullyQualifiedName":"org.owasp.benchmark.testcode.BenchmarkTest02740.doPost(HttpServletRequest, HttpServletResponse)"}]}]}],"originalUriBaseIds":{},"taxonomies":[{"name":"CWE","version":"4.10","minimumRequiredLocalizedDataSemanticVersion":"4.10","releaseDateUtc":"2023-01-31","guid":"b8c54a32-de19-51d2-9a08-f0abfbaa7310","informationUri":"https://cwe.mitre.org/data/published/cwe_v4.10.pdf/","downloadUri":"https://cwe.mitre.org/data/xml/cwec_v4.10.xml.zip","isComprehensive":true,"organization":"MITRE","language":"en","shortDescription":{"text":"The MITRE Common Weakness Enumeration"},"taxa":[{"id":"113","guid":"d73c47e6-4eac-5976-b3be-a48b59a5bb12","shortDescription":{"text":"Improper Neutralization of CRLF Sequences in HTTP Headers ('HTTP Request/Response Splitting')"},"fullDescription":{"text":"The product receives data from an HTTP agent/component (e.g., web server, proxy, browser, etc.), but it does not neutralize or incorrectly neutralizes CR and LF characters before the data is included in outgoing HTTP headers."},"defaultConfiguration":{"level":"none"}},{"id":"20","guid":"b090a1e1-92d8-51fd-ac1f-fbc6939eb44d","shortDescription":{"text":"Improper Input Validation"},"fullDescription":{"text":"The product receives input or data, but it does\n        not validate or incorrectly validates that the input has the\n        properties that are required to process the data safely and\n        correctly."},"defaultConfiguration":{"level":"error"}},{"id":"209","guid":"f4809885-c9d6-5931-8bb1-50534e74f6cc","shortDescription":{"text":"Generation of Error Message Containing Sensitive Information"},"fullDescription":{"text":"The product generates an error message that includes sensitive information about its environment, users, or associated data."},"defaultConfiguration":{"level":"error"}},{"id":"22","guid":"19cf96fc-1234-5a3d-8e5d-21b225b7d3e8","shortDescription":{"text":"Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"},"fullDescription":{"text":"The product uses external input to construct a pathname that is intended to identify a file or directory that is located underneath a restricted parent directory, but the product does not properly neutralize special elements within the pathname that can cause the pathname to resolve to a location that is outside of the restricted directory."},"defaultConfiguration":{"level":"error"}},{"id":"23","guid":"0d846f4f-7e64-50e6-8a72-98944a69c98f","shortDescription":{"text":"Relative Path Traversal"},"fullDescription":{"text":"The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize sequences such as \"..\" that can resolve to a location that is outside of that directory."},"defaultConfiguration":{"level":"none"}},{"id":"259","guid":"50b06d54-751a-5af0-9a8c-5ba16677987d","shortDescription":{"text":"Use of Hard-coded Password"},"fullDescription":{"text":"The product contains a hard-coded password, which it uses for its own inbound authentication or for outbound communication to external components."},"defaultConfiguration":{"level":"error"}},{"id":"315","guid":"1e8b2edd-a6e3-55f9-b6f2-739f59d0fd49","shortDescription":{"text":"Cleartext Storage of Sensitive Information in a Cookie"},"fullDescription":{"text":"The product stores sensitive information in cleartext in a cookie."},"defaultConfiguration":{"level":"none"}},{"id":"326","guid":"8ca107ca-7176-5a2e-96fd-d4f831987533","shortDescription":{"text":"Inadequate Encryption Strength"},"fullDescription":{"text":"The product stores or transmits sensitive data using an encryption scheme that is theoretically sound, but is not strong enough for the level of protection required."},"defaultConfiguration":{"level":"none"}},{"id":"327","guid":"09eca73c-fb11-5ac5-9ef3-eba96de7209c","shortDescription":{"text":"Use of a Broken or Risky Cryptographic Algorithm"},"fullDescription":{"text":"The product uses a broken or risky cryptographic algorithm or protocol."},"defaultConfiguration":{"level":"error"}},{"id":"328","guid":"dc1e99c1-c57b-5af0-85a4-9ad3bfac9c82","shortDescription":{"text":"Use of Weak Hash"},"fullDescription":{"text":"The product uses an algorithm that produces a digest (output value) that does not meet security expectations for a hash function that allows an adversary to reasonably determine the original input (preimage attack), find another input that can produce the same hash (2nd preimage attack), or find multiple inputs that evaluate to the same hash (birthday attack)."},"defaultConfiguration":{"level":"none"}},{"id":"329","guid":"21c13c15-dea9-5891-a866-6cfad99be821","shortDescription":{"text":"Generation of Predictable IV with CBC Mode"},"fullDescription":{"text":"The product generates and uses a predictable initialization Vector (IV) with Cipher Block Chaining (CBC) Mode, which causes algorithms to be susceptible to dictionary attacks when they are encrypted under the same key."},"defaultConfiguration":{"level":"warning"}},{"id":"330","guid":"80cf7ee1-5a29-5fb4-a2f1-701272abf9b7","shortDescription":{"text":"Use of Insufficiently Random Values"},"fullDescription":{"text":"The product uses insufficiently random numbers or values in a security context that depends on unpredictable numbers."},"defaultConfiguration":{"level":"error"}},{"id":"353","guid":"d5eee5a3-428a-56c9-8338-c0bd8aa08841","shortDescription":{"text":"Missing Support for Integrity Check"},"fullDescription":{"text":"The product uses a transmission protocol that does not include a mechanism for verifying the integrity of the data during transmission, such as a checksum."},"defaultConfiguration":{"level":"warning"}},{"id":"36","guid":"51b687b0-9f65-5769-9941-887f39f93d17","shortDescription":{"text":"Absolute Path Traversal"},"fullDescription":{"text":"The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize absolute path sequences such as \"/abs/path\" that can resolve to a location that is outside of that directory."},"defaultConfiguration":{"level":"none"}},{"id":"501","guid":"9c037589-7f2b-52eb-8031-405387da7c6b","shortDescription":{"text":"Trust Boundary Violation"},"fullDescription":{"text":"The product mixes trusted and untrusted data in the same data structure or structured message."},"defaultConfiguration":{"level":"none"}},{"id":"564","guid":"2937d3c1-d521-5f1e-815b-1eaa5850e189","shortDescription":{"text":"SQL Injection: Hibernate"},"fullDescription":{"text":"Using Hibernate to execute a dynamic SQL statement built with user-controlled input can allow an attacker to modify the statement's meaning or to execute arbitrary SQL commands."},"defaultConfiguration":{"level":"none"}},{"id":"611","guid":"b7383f8c-a52b-52c9-b7d1-95a3c511d9da","shortDescription":{"text":"Improper Restriction of XML External Entity Reference"},"fullDescription":{"text":"The product processes an XML document that can contain XML entities with URIs that resolve to documents outside of the intended sphere of control, causing the product to embed incorrect documents into its output."},"defaultConfiguration":{"level":"none"}},{"id":"614","guid":"06a50c3b-db90-53ee-9dcd-bdf22e7b9a5a","shortDescription":{"text":"Sensitive Cookie in HTTPS Session Without 'Secure' Attribute"},"fullDescription":{"text":"The Secure attribute for sensitive cookies in HTTPS sessions is not set, which could cause the user agent to send those cookies in plaintext over an HTTP session."},"defaultConfiguration":{"level":"none"}},{"id":"643","guid":"23fc655b-68b0-5f0d-beac-3da3e4a45ce5","shortDescription":{"text":"Improper Neutralization of Data within XPath Expressions ('XPath Injection')"},"fullDescription":{"text":"The product uses external input to dynamically construct an XPath expression used to retrieve data from an XML database, but it does not neutralize or incorrectly neutralizes that input. This allows an attacker to control the structure of the query."},"defaultConfiguration":{"level":"error"}},{"id":"732","guid":"fa71f661-79b7-50c6-b5b8-bfdbc6346255","shortDescription":{"text":"Incorrect Permission Assignment for Critical Resource"},"fullDescription":{"text":"The product specifies permissions for a security-critical resource in a way that allows that resource to be read or modified by unintended actors."},"defaultConfiguration":{"level":"error"}},{"id":"78","guid":"de860c32-bc93-5e70-89d7-0877e5abaefb","shortDescription":{"text":"Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')"},"fullDescription":{"text":"The product constructs all or part of an OS command using externally-influenced input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could modify the intended OS command when it is sent to a downstream component."},"defaultConfiguration":{"level":"error"}},{"id":"79","guid":"1f9356da-1df4-5c99-9c56-110ae7cab98e","shortDescription":{"text":"Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')"},"fullDescription":{"text":"The product does not neutralize or incorrectly neutralizes user-controllable input before it is placed in output that is used as a web page that is served to other users."},"defaultConfiguration":{"level":"error"}},{"id":"807","guid":"2626368c-6d4f-5429-aa52-ee96a99c8655","shortDescription":{"text":"Reliance on Untrusted Inputs in a Security Decision"},"fullDescription":{"text":"The product uses a protection mechanism that relies on the existence or values of an input, but the input can be modified by an untrusted actor in a way that bypasses the protection mechanism."},"defaultConfiguration":{"level":"error"}},{"id":"89","guid":"ef952f10-a202-504c-8649-9ffcb2291d69","shortDescription":{"text":"Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')"},"fullDescription":{"text":"The product constructs all or part of an SQL command using externally-influenced input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could modify the intended SQL command when it is sent to a downstream component."},"defaultConfiguration":{"level":"error"}},{"id":"90","guid":"7efd6ad9-f90e-585a-aced-104f4e0ae662","shortDescription":{"text":"Improper Neutralization of Special Elements used in an LDAP Query ('LDAP Injection')"},"fullDescription":{"text":"The product constructs all or part of an LDAP query using externally-influenced input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could modify the intended LDAP query when it is sent to a downstream component."},"defaultConfiguration":{"level":"none"}},{"id":"918","guid":"5bb88194-5222-563c-b8e6-b0b769ed3c9a","shortDescription":{"text":"Server-Side Request Forgery (SSRF)"},"fullDescription":{"text":"The web server receives a URL or similar request from an upstream component and retrieves the contents of this URL, but it does not sufficiently ensure that the request is being sent to the expected destination."},"defaultConfiguration":{"level":"none"}}]}]}]}